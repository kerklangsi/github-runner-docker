# ==========================================
# GitHub Self-Hosted Runner Environment Config
# ==========================================

# 1. Target GitHub URL (REQUIRED)
# Repository URL format:  https://github.com/owner/repository
# Organization URL format: https://github.com/orgs/organization-name
TARGET_URL=https://github.com/owner/repository

# 2. Authentication (Provide either RUNNER_TOKEN OR ACCESS_TOKEN)

# Option A: One-time Runner Registration Token
# Get from: GitHub Repo -> Settings -> Actions -> Runners -> New self-hosted runner
RUNNER_TOKEN=

# Option B: Personal Access Token (PAT / ACCESS_TOKEN)
# If provided, container automatically fetches registration token via GitHub API on boot.
# Required PAT scopes: 'repo' (for repositories) or 'admin:org' (for organizations)
ACCESS_TOKEN=

# 3. Custom Runner Settings (OPTIONAL)
# Name of the runner displayed in GitHub Actions tab
RUNNER_NAME=docker-runner-01

# Comma-separated labels to target in workflows (`runs-on: [self-hosted, linux]`)
RUNNER_LABELS=self-hosted,linux,x64,docker

# Runner group name (Organization / Enterprise level only)
RUNNER_GROUP=Default

# 4. Advanced Execution Options (OPTIONAL)
# Set to 'true' to auto-unregister and shutdown container after executing ONE job
EPHEMERAL=false

# Set to 'true' to disable automatic GitHub runner binary updates
DISABLE_AUTO_UPDATE=false

# Working directory for runner jobs inside container
RUNNER_WORKDIR=_work
